{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Onix Config",
  "type": "object",
  "required": ["schemaVersion", "operationalStore", "writeBoundary"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "operationalStore": {
      "type": "string"
    },
    "writeBoundary": {
      "type": "object",
      "required": ["thematicNotes", "researchInbox", "referenceLibrary"],
      "additionalProperties": false,
      "properties": {
        "thematicNotes": {
          "type": "string"
        },
        "researchInbox": {
          "type": "string"
        },
        "referenceLibrary": {
          "type": "string"
        }
      }
    }
  }
}
